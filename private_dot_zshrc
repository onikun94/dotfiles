ZSH_DIR="${HOME}/.zshrc.d"
if [[ -d "$ZSH_DIR" && -r "$ZSH_DIR" ]]; then
    # Keep startup order explicit: paths and runtimes first, presentation last.
    for relative_file in path.zsh direnv.zsh git.zsh alias.zsh profile.zsh architecture.zsh; do
        file="${ZSH_DIR}/${relative_file}"
        [[ -r "$file" ]] && source "$file"
    done

    # Plugins are optional and load after the managed core settings.
    for file in "${ZSH_DIR}"/plugin/**/*.zsh(N); do
        if [[ "$file" == */zsh-autocomplete/* && "$file" != */zsh-autocomplete.plugin.zsh ]]; then
            continue
        fi
        [[ -r "$file" ]] && source "$file"
    done
fi

# Load local settings (not managed by chezmoi)
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
